import pandas as pd
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score

# Load dataset
df = pd.read_csv("house_price_regression_dataset.csv")

# Print columns to verify
print("Columns in Dataset:", df.columns.tolist())

# Q.1 Correlation between Year_Built and House_Price
corr_q1 = df["Year_Built"].corr(df["House_Price"])
print("\nQ.1 Correlation (Year_Built vs House_Price):", corr_q1)

# Q.2 Full Correlation Matrix
corr_matrix = df.corr(numeric_only=True)
print("\nQ.2 Correlation Matrix:\n", corr_matrix)

# Q.3 & Q.4 Model 1: X = Square_Footage, Y = House_Price
X1 = df[["Square_Footage"]]
y1 = df["House_Price"]
m1 = LinearRegression().fit(X1, y1)
r2_1 = r2_score(y1, m1.predict(X1))

print(f"\nModel 1 (Square_Footage -> House_Price):")
print(f"  Coefficient: {m1.coef_[0]:.4f}, Intercept: {m1.intercept_:.4f}")
print(f"  R2 Score: {r2_1:.4f}")

# Q.5 Model 2: X = Year_Built, Y = House_Price
X2 = df[["Year_Built"]]
y2 = df["House_Price"]
m2 = LinearRegression().fit(X2, y2)
r2_2 = r2_score(y2, m2.predict(X2))
print(f"\nModel 2 (Year_Built -> House_Price) R2 Score: {r2_2:.4f}")

# Q.6 Model 3: X = Lot_Size, Y = House_Price
X3 = df[["Lot_Size"]]
y3 = df["House_Price"]
m3 = LinearRegression().fit(X3, y3)
r2_3 = r2_score(y3, m3.predict(X3))
print(f"\nModel 3 (Lot_Size -> House_Price) R2 Score: {r2_3:.4f}")

# Q.7 Comparison
print("\n=== Comparison of R2 Scores ===")
print(f"Square_Footage -> House_Price: {r2_1:.4f}")
print(f"Year_Built     -> House_Price: {r2_2:.4f}")
print(f"Lot_Size       -> House_Price: {r2_3:.4f}")
